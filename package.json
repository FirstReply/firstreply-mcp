{
  "name": "@firstreply/mcp",
  "version": "0.1.0",
  "description": "MCP server exposing FirstReply customer support operations as tools",
  "license": "MIT",
  "type": "module",
  "bin": {
    "firstreply-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
